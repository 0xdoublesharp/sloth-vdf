{
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts", "sdk/**/*.ts", "test/typescript/**/*.ts", "vitest.config.mts"],
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  }
}
